# ============================================================
# Western Credit Institute — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#
# `.env` is git-ignored (see .gitignore line 43) so your real
# secrets will never be committed. NEVER commit `.env`.
# ============================================================


# ------------------------------------------------------------
# 1. SUPABASE  (REQUIRED)
# ------------------------------------------------------------
# Find these in your Supabase dashboard:
#   Project Settings (gear icon) -> API
#
# EXPO_PUBLIC_SUPABASE_URL   = the "Project URL" field
# EXPO_PUBLIC_SUPABASE_ANON_KEY = the "anon" / "public" key
#
# These are SAFE to expose to the client. The anon key is public
# by design and is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here


# ------------------------------------------------------------
# 1b. SUPABASE SERVICE ROLE KEY  (RECOMMENDED FOR PRODUCTION)
# ------------------------------------------------------------
# Same dashboard page as above:
#   Project Settings (gear icon) -> API -> "service_role" / "secret"
#
# ⚠️  DANGER: this key BYPASSES Row Level Security completely.
#     Anyone holding it has full read/write access to your entire
#     database. Treat it like a root password.
#
# SECURITY: no "EXPO_PUBLIC_" prefix, on purpose. That prefix is what
# bundles a variable into the client app where end users can read it.
# NEVER rename this to EXPO_PUBLIC_SUPABASE_SERVICE_ROLE_KEY, and never
# add an EXPO_PUBLIC_ fallback for it in code.
#
# Used only by lib/supabase-admin.ts, which is imported only from
# backend/. If unset, the backend falls back to the anon key and keeps
# working via the permissive policies from migration 024.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ------------------------------------------------------------
# 2. API BASE URL  (REQUIRED — app throws an error without it)
# ------------------------------------------------------------
# lib/trpc.ts throws:
#   "Rork did not set EXPO_PUBLIC_RORK_API_BASE_URL, please use support"
# if this is missing. The tRPC client appends "/api/trpc" to it.
#
# BUILDING IN RORK? Do not set this here — Rork injects it automatically at
# build time for its hosted Hono/tRPC backend, and setting it yourself can
# conflict with Rork's tunnel. To see the injected value: More -> Secrets
# (look for a "Managed by Rork" row, press the eye), or after a rebuild
# check More -> Code -> Logs for "[tRPC] API base URL: https://..."
#
# Local development (Expo web on the same machine):
#     http://localhost:8081
#
# Local development (physical device on your Wi-Fi) — use your
# computer's LAN IP, NOT localhost:
#     http://192.168.1.50:8081
#
# Rork tunnel / production: use the https URL Rork gives you.
# Do NOT include a trailing slash and do NOT include /api/trpc.
EXPO_PUBLIC_RORK_API_BASE_URL=http://localhost:8081


# ------------------------------------------------------------
# 3. OPENAI  (OPTIONAL — demo mode is used if omitted)
# ------------------------------------------------------------
# Powers the My Agent chat with real AI + function calling.
# Get a key at: https://platform.openai.com/api-keys
#
# SECURITY: OPENAI_API_KEY has NO "EXPO_PUBLIC_" prefix on purpose.
# Anything prefixed EXPO_PUBLIC_ is bundled into the client app and
# is readable by end users. Your OpenAI key must stay server-side.
# Never rename this to EXPO_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=sk-proj-replace-with-your-real-key

# Model to use. gpt-4o-mini is fast + cheap and supports the
# function calling the agent tools require.
OPENAI_MODEL=gpt-4o-mini

# Only change this if you use an OpenAI-compatible provider
# (Azure OpenAI, Groq, Together AI, OpenRouter, etc.).
OPENAI_BASE_URL=https://api.openai.com/v1


# ------------------------------------------------------------
# 4. OPTIONAL THIRD-PARTY SERVICES
# ------------------------------------------------------------
# Not required for the My Agent feature. Leave blank/omit unless
# you are using video hosting or maps.
# BUNNY_STREAM_API_KEY=
# CLOUDFLARE_STREAM_API_TOKEN=
# MAPBOX_ACCESS_TOKEN=
